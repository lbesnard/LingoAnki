# Base image for LingoAnki — contains the heavy ML dependencies.
#
# Build and push this ONLY when you need to upgrade torch, whisper,
# spacy, piper-tts, or ovos-tts-plugin-piper. Normal app rebuilds use
# Dockerfile (FROM lozzaroo/lingodiary-base:latest) and are much faster.
#
# To rebuild and push:
#   bash scripts/build_base.sh
#
# Pinned versions (update here + in pyproject.toml when upgrading):
#   torch              2.6.0
#   openai-whisper     20240930  (git main)
#   spacy              3.7.5
#   piper-tts          1.2.0
#   ovos-tts-plugin-piper  0.0.2

# 3.10 required for piper
FROM python:3.10.1

ENV POETRY_VERSION=2.3.3
ENV POETRY_HOME=/opt/poetry
ENV POETRY_NO_INTERACTION=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install Poetry binary + system tools + ffmpeg in one cached layer
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ffmpeg \
    && curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s ${POETRY_HOME}/bin/poetry /usr/local/bin/poetry \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install heavy ML packages into the system Python.
# Versions are pinned here so this layer is only invalidated when YOU
# deliberately change one of these lines — not when poetry.lock drifts.
RUN pip install --no-cache-dir \
    "torch==2.6.0" \
    "torchaudio==2.6.0" \
    --index-url https://download.pytorch.org/whl/cpu

# Install whisper separately (git-based, takes time to build)
RUN pip install --no-cache-dir \
    "openai-whisper @ git+https://github.com/openai/whisper.git@main"

# Install spacy and piper TTS (also large / slow)
RUN pip install --no-cache-dir \
    "spacy==3.7.5" \
    "piper-tts==1.2.0" \
    "ovos-tts-plugin-piper==0.0.2"

# Prepare writable data directory for piper voice models
RUN mkdir -p /app/.local && chown -R 1000:1000 /app/.local
